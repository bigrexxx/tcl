# TCL Babcock Hub — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Supabase — get from https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJ..."          # anon / public key
SUPABASE_SERVICE_ROLE_KEY="eyJ..."         # service role key — KEEP SECRET

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Admin dashboard credentials — pick a strong username and password
ADMIN_USERNAME="tcl@admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-a-random-secret"

# Resend — get from https://resend.com/api-keys
RESEND_API_KEY="re_..."

# The "from" address for approval emails (must be a verified Resend sender domain)
EMAIL_FROM="TCL Babcock <no-reply@yourdomain.com>"
